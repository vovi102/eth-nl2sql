{
  "source": "bigquery-public-data.crypto_ethereum",
  "window": {
    "start": "2026-10-01",
    "end_exclusive": "2026-11-01"
  },
  "project": "nl2sparql-thesis",
  "queries": {
    "blocks": "SELECT number, `hash`, parent_hash, timestamp, miner, size, gas_limit, gas_used,\ntransaction_count, base_fee_per_gas, blob_gas_used, excess_blob_gas\nFROM `bigquery-public-data.crypto_ethereum.blocks`\nWHERE timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND timestamp < TIMESTAMP '2026-11-01 00:00:00+00'",
    "transactions": "SELECT `hash`, nonce, transaction_index, from_address, to_address,\nCAST(value AS STRING) AS value, gas, gas_price, max_fee_per_gas,\nmax_priority_fee_per_gas, transaction_type, receipt_status, receipt_gas_used,\nreceipt_cumulative_gas_used, receipt_effective_gas_price, receipt_contract_address,\nmax_fee_per_blob_gas, receipt_blob_gas_price, receipt_blob_gas_used,\nARRAY_LENGTH(blob_versioned_hashes) AS blob_count, block_number, block_timestamp\nFROM `bigquery-public-data.crypto_ethereum.transactions`\nWHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00'",
    "token_transfers": "SELECT transaction_hash, log_index, token_address, from_address, to_address, value,\nblock_number, block_timestamp\nFROM `bigquery-public-data.crypto_ethereum.token_transfers`\nWHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00'",
    "contracts": "SELECT address, is_erc20, is_erc721, block_number, block_timestamp\nFROM `bigquery-public-data.crypto_ethereum.contracts`\nWHERE block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00' AND address IN (\nSELECT to_address FROM `bigquery-public-data.crypto_ethereum.transactions` WHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00'\nUNION DISTINCT SELECT receipt_contract_address FROM `bigquery-public-data.crypto_ethereum.transactions` WHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00'\nUNION DISTINCT SELECT token_address FROM `bigquery-public-data.crypto_ethereum.token_transfers` WHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00')",
    "tokens": "SELECT address, symbol, name, decimals, decimals_int, total_supply, token_standard,\nARRAY_TO_STRING(token_standards, '|') AS token_standards,\nARRAY_TO_STRING(protocols, '|') AS protocols, is_erc20, is_erc721, is_erc1155,\nimplementation_address, proxy_standard, creator_address, creation_transaction_hash,\nblock_number, block_timestamp\nFROM `bigquery-public-data.crypto_ethereum.tokens_latest`\nWHERE address IN (SELECT token_address FROM `bigquery-public-data.crypto_ethereum.token_transfers` WHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00')",
    "amended_tokens": "SELECT address, symbol, name, decimals\nFROM `bigquery-public-data.crypto_ethereum.amended_tokens`\nWHERE address IN (SELECT token_address FROM `bigquery-public-data.crypto_ethereum.token_transfers` WHERE block_timestamp >= TIMESTAMP '2026-10-01 00:00:00+00' AND block_timestamp < TIMESTAMP '2026-11-01 00:00:00+00')"
  },
